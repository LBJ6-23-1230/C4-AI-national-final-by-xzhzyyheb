# 知学 Mate · 后端环境变量模板
#
# 复制为 .env 后填写真实 Key：Copy-Item .env.example .env
# .env 已在 .gitignore 中，绝不入库、绝不提交到比赛压缩包。

# ---- 通义千问 / DashScope ----
# 未填 Key 时，聊天使用确定性规则。配置 Key 后，按所用账号验证模型权限和可用性。
# DASHSCOPE_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 自然语言层：文本意图/回复与图片识别。独立设置 LLM_VL_MODEL 可让文本和识图
# 使用不同模型。
#
# 以下为代码默认值。用账号支持的实际模型标识替换，并执行工具主动检查。
LLM_MODEL=qwen3.8-flash
LLM_VL_MODEL=qwen3-vl-plus
# 工作流决策层：只做结构化 JSON 决策，用同一档纯文本模型，避免占用 VL 配额。
# 与自然语言层分开是刻意设计，不要为了"统一"而改成同一个模型。
LLM_DECISION_MODEL=qwen3.8-flash
LLM_TIMEOUT_SECONDS=30
# SDK automatic retries stay disabled in the shared budget layer.
LLM_MAX_RETRIES=0
# Qwen3 short structured tasks default to non-thinking mode on DashScope only.
LLM_ENABLE_THINKING=0
LLM_DECISION_TIMEOUT_SECONDS=8
LLM_EMBED_TIMEOUT_SECONDS=30
# Bounded review workers and queue; timed-out reviews backfill safely.
LLM_REVIEW_WORKERS=4
LLM_REVIEW_QUEUE_SIZE=8
# 语义检索用的向量模型（知识库检索的 semanticWeight > 0 时才会调用）
EMBED_MODEL=text-embedding-v3

# 本机演示可用 SQLite；需要保留旧 JSON 库数据时先迁移并验证。
# ZHIXUE_DB=sqlite

# ---- 可选：PostgreSQL（远程共享库 / 多机联调，是生产环境的既定后端）----
# 设 ZHIXUE_DB=postgresql 时必须同时给 DATABASE_URL；驱动固定为 Psycopg 3。
# 空库先执行 `alembic upgrade head`，再启动；库里的 alembic_version 必须等于
# app/repositories/pg_schema.py 的 REVISION，否则启动自检直接失败（不会带病启动）。
# 生产环境（ZHIXUE_ENV=production）还要求 sslmode=verify-full 且带 sslrootcert。
# ZHIXUE_DB=postgresql
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
# 连接池（可选，默认 5 + 2）：DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=2
# 搜索路径（可选，默认 public）：DB_SCHEMA=public

# ---- 备选：DeepSeek（同样是 OpenAI 兼容协议）----
# DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_VL_MODEL=deepseek-chat
# LLM_DECISION_MODEL=deepseek-chat

# ---- 手机号验证码 ----
# SMS_PROVIDER 留空，且显式设置 ZHIXUE_ENV=development（或 dev）时，
# /auth/send-code 返回 smsDelivered=false 和 devCode，只供受控开发/演示。
# 其他环境拒绝回显开发验证码。当前构建未接入真实短信发送适配器，
# 设置 SMS_PROVIDER 会得到 SMS_PROVIDER_UNAVAILABLE。现场可使用手机号和密码。
# ZHIXUE_ENV=development
# SMS_PROVIDER=

# ---- 服务端口 ----
PORT=5000

# ---- 开发管理工具（默认关闭，公开试用环境必须保持关闭） ----
# 开启后允许演示重置和包含全量数据的实验快照，仅限受控本机调试。
# ZHIXUE_ENABLE_DEV_TOOLS=1
# 整页识题独立等待预算；前端图片请求等待150秒。
LLM_VISION_TIMEOUT_SECONDS=120

# ---- 可选：服务端华为 Push Kit 通知消息（独立 reminder_worker.py） ----
# 未配置时 pushConfigured=false，不发送外部通知；首页事件和用户动作仍可使用。
# 项目、签名、终端Token及通知类别需要在真实开发者项目中核对。
# 服务账号文件相对于后端目录，JWT 由后端自动签发和更新。
# HUAWEI_PUSH_SERVICE_ACCOUNT_FILE=../../private/huawei-push-service-account.json
# 兼容旧部署：不设置服务账号文件时可用外部轮换的 JWT 和项目 ID。
# HUAWEI_PUSH_PROJECT_ID=
# HUAWEI_PUSH_JWT_FILE=
# HUAWEI_PUSH_CATEGORY=MARKETING
# 自分类权益审核通过前，可临时用华为测试消息（<=10 个 Token、<=1000 条/天）；
# 联调完成后必须删除该开关，改用已获准的真实分类。
# HUAWEI_PUSH_TEST_MESSAGE=1

# Account Kit 一次性授权码校验。与 module.json5 及 AGC 的签名配置对应。
HUAWEI_ACCOUNT_CLIENT_ID=
HUAWEI_ACCOUNT_CLIENT_SECRET=
