# Copy to .env.production; never commit real values.
APP_ENV=production
ZHIXUE_ENV=production
ZHIXUE_DB=postgresql
DATABASE_URL=postgresql+psycopg://app:CHANGE_ME@rds.internal:5432/zhixue?sslmode=verify-full&sslrootcert=/run/secrets/rds-ca.pem
DEMO_ENABLED=false
ZHIXUE_ENABLE_DEV_TOOLS=0
ZHIXUE_QUIET=1
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
WEB_CONCURRENCY=2
WEB_THREADS=4
ZHIXUE_CORS_ORIGINS=https://www.example.com
FILE_STORAGE=obs
S3_ENDPOINT_URL=https://obs.cn-north-4.myhuaweicloud.com
S3_REGION=cn-north-4
S3_BUCKET=CHANGE_ME_PRIVATE_BUCKET
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
DASHSCOPE_API_KEY=
LLM_MODEL=qwen3.8-flash
LLM_VL_MODEL=qwen3-vl-plus
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=0
# Set this to your private registry plus immutable release tag/digest.
APP_IMAGE=registry.example.com/zhixue:CHANGE_ME
# Optional Push Kit. A separately managed process must rotate the JWT file.
# HUAWEI_PUSH_PROJECT_ID=
# HUAWEI_PUSH_JWT_FILE=/run/secrets/push.jwt
# HUAWEI_PUSH_CATEGORY=MARKETING
